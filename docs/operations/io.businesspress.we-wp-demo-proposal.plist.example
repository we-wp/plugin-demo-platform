<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.businesspress.we-wp-demo-proposal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/absolute/path/to/plugin-demo-platform/scripts/serve.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/absolute/path/to/plugin-demo-platform</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WE_WP_DEMO_PORT</key>
    <string>8783</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/absolute/path/to/plugin-demo-platform/preview.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/path/to/plugin-demo-platform/preview.stderr.log</string>
</dict>
</plist>
